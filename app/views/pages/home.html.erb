<div class="hero">
  <h1 class="page-title">Blood Donor Connect</h1>
  <p>Find blood donors near you, or ask for help.</p>

  <%# Signed out, both buttons lead to a page that asks you to log in. %>
  <div class="actions">
    <%= link_to "Request blood", new_blood_request_path, class: "btn btn-primary" %>
    <%= link_to "Become a donor", new_donor_profile_path, class: "btn" %>
  </div>

  <% if signed_in? %>
    <p class="meta">Signed in as <%= Current.user.name %>.</p>
  <% end %>
</div>
